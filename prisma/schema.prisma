generator client {

  provider        = "prisma-client-js"

  previewFeatures = ["postgresqlExtensions"]

}



datasource db {

  provider   = "postgresql"

  url        = env("DATABASE_URL")

  extensions = [pgvector(map: "vector")]

}



model User {

  id            BigInt   @id

  username      String?

  firstName     String

  digestEnabled Boolean  @default(false)

  createdAt     DateTime @default(now())

}



enum MatchInternalStatus {

  PENDING

  SCRAPED

  ANALYZED

}



model Match {

  id         String   @id @default(uuid())

  externalId String   @unique

  homeTeam   String

  awayTeam   String

  league     String

  date       DateTime

  sport      String   @default("football")

  /// Жизненный цикл в приложении: очередь анализа (PENDING) → после LLM (ANALYZED); SCRAPED — зарезервировано под этап обогащения

  internalStatus MatchInternalStatus @default(PENDING)

  /// Скрапер: SOURCE + METADATA (title/description/keywords) + ARTICLE CONTENT для ИИ

  rawContent String? @db.Text

  /// Gemini embedding (gemini-embedding-001 и т.д., 768 через outputDimensionality) — vector(768)

  embedding Unsupported("vector(768)")?

  /// После последнего анализа: например "High Confidence" при взвешенной уверенности > 75%

  confidenceStatus String? @db.VarChar(32)



  /// Когда последний раз завершён фоновый анализ

  analyzedAt DateTime?

  /// Исход 1 / X / 2

  analysisPrediction      String? @db.VarChar(1)

  analysisSummary         String? @db.Text

  analysisFinalConfidence Int?

  analysisAiConfidence    Int?

  /// JSON: { f1: { score, reasoning }, ... f10 }

  analysisFactors Json?

}


