# =============================================================================
# Analytics_bot — шаблон окружения
# Скопируй в .env и заполни значения. Источник ключей: src/core/config.ts
# =============================================================================

# -----------------------------------------------------------------------------
# Приложение
# -----------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# База данных (обязательно)
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://admin:secret_password@localhost:5432/analytics_db?schema=public"

# -----------------------------------------------------------------------------
# Telegram (обязательно) — токен: @BotFather
# Если используешь другое имя: TELEGRAM_BOT_TOKEN — код подставит его как BOT_TOKEN.
# -----------------------------------------------------------------------------
BOT_TOKEN="0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
# Если api.telegram.org не открывается: свой Bot API / прокси без слэша в конце (grammY → apiRoot).
# TELEGRAM_API_ROOT="https://example.com"
# Вторая попытка getMe, если основной хост не ответил: зеркало, Cloudflare Worker или свой VPS с telegram-bot-api.
# Пример деплоя прокси: https://github.com/AmRo045/telegram-api-proxy-worker
# TELEGRAM_API_FALLBACK_ROOT="https://your-worker.workers.dev"
# TELEGRAM_HTTP_TIMEOUT_SECONDS="30"

# -----------------------------------------------------------------------------
# LLM — OpenRouter (https://openrouter.ai/)
# Ключ: https://openrouter.ai/keys  |  модели: https://openrouter.ai/models
# Без OPENROUTER_API_KEY процесс поднимется, но запросы к LLM упадут.
# Алиасы: OPENAI_API_KEY → OPENROUTER_API_KEY, OPENAI_API_BASE_URL → LLM_BASE_URL (если основные пустые).
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY="sk-or-v1-..."
LLM_BASE_URL="https://openrouter.ai/api/v1"
PRIMARY_REASONING_MODEL="openai/gpt-4o"
LONG_CONTEXT_MODEL="openai/gpt-4o-mini"
# OPENROUTER_HTTP_REFERER="https://your-site.example"
# OPENROUTER_APP_TITLE="Analytics_bot"

# -----------------------------------------------------------------------------
# Скрапер (Playwright): true — без окна браузера
# -----------------------------------------------------------------------------
SCRAPER_HEADLESS="true"

# -----------------------------------------------------------------------------
# Football Data API (опционально) — https://www.football-data.org/
# Алиас: FOOTBALL_DATA_API_TOKEN → FOOTBALL_DATA_API_KEY (если KEY пустой).
# -----------------------------------------------------------------------------
# FOOTBALL_DATA_API_KEY="your-api-token"

# -----------------------------------------------------------------------------
# Крон — периодический дайджест в чат (подписка: /digest on в боте)
# Выражение — 5 полей node-cron, напр. "0 9 * * *" = каждый день 09:00
# -----------------------------------------------------------------------------
ENABLE_CRON="false"
CRON_TZ="UTC"
CRON_DIGEST_SCHEDULE="0 9 * * *"
CRON_DIGEST_LOOKAHEAD_HOURS="48"
CRON_MAX_DIGEST_LLM="10"
# Перед дайджестом вызывать npm run scrape-логику (тяжело, Playwright)
CRON_RUN_SCRAPE="false"
