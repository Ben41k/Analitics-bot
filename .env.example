NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Host dev against compose `postgres` (see docker-compose.yml published port):
DATABASE_URL=postgresql://analytics:analytics@localhost:5433/analytics?sslmode=disable

# Inside Docker Compose `app` service, use the service hostname instead:
# DATABASE_URL=postgresql://analytics:analytics@postgres:5432/analytics?sslmode=disable

# Football-Data.org — https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=
# Comma-separated competition ids (e.g. Premier League = 2021)
FOOTBALL_DATA_COMPETITION_IDS=2021

# OpenAI-compatible API (embeddings + chat)
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

PRIMARY_REASONING_MODEL=gpt-4o-mini
LONG_CONTEXT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

TELEGRAM_BOT_TOKEN=
# Secret path segment for POST /telegram/webhook/:secret
TELEGRAM_WEBHOOK_SECRET_PATH=change-me-please

ENABLE_CRON=false
CRON_TZ=UTC

# Scraping / pipeline limits
SCRAPER_TAKE_LIMIT=5
MIN_RAW_CONTENT_LENGTH=150
SCRAPER_NAVIGATION_TIMEOUT_MS=45000
FOOTBALL_SYNC_DAYS_AHEAD=14
FOOTBALL_SYNC_DAYS_PAST=7

# Retention
RETENTION_DAYS=120

# Task timeouts (ms)
TASK_TIMEOUT_MS_FOOTBALL_SYNC=120000
TASK_TIMEOUT_MS_FLASHSCORE_SCRAPE=300000
TASK_TIMEOUT_MS_EMBEDDING=300000
TASK_TIMEOUT_MS_ANALYZE=600000
TASK_TIMEOUT_MS_RETENTION=60000

# RAG
RAG_TOP_K=5
