# =============================================================================
# Analytics Bot — шаблон переменных окружения
# =============================================================================
# Скопируйте в .env и вставьте свои ключи (см. шаги ниже). Файл .env подхватывает
# приложение через пакет dotenv при старте (npm run dev / npm start).
# Шаги:
#   1) copy .env.example .env  (или cp …)
#   2) docker compose up -d postgres
#   3) Заполните: DATABASE_URL (уже для :5433), TELEGRAM_BOT_TOKEN, FOOTBALL_DATA_API_TOKEN;
#      при необходимости OPENAI_API_KEY (иначе embedding/analyze в cron упадут).
#   4) npm ci && npm run db:migrate && npm run dev
#
# NODE_ENV=development — long polling Telegram. В Docker-образе production — только webhook:
#   POST https://<хост>/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET_PATH>
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL (required) ---
# npm run dev on host + postgres service from docker-compose (host port 5433):
DATABASE_URL=postgresql://analytics:analytics@localhost:5433/analytics?sslmode=disable
# Same file used inside docker-compose `app` service (uncomment for container only):
# DATABASE_URL=postgresql://analytics:analytics@postgres:5432/analytics?sslmode=disable

# --- Football-Data.org (required for football_sync cron) ---
# Register: https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_COMPETITION_IDS=2021

# --- Telegram (required for bot replies) ---
# @BotFather token
TELEGRAM_BOT_TOKEN=
# Webhook path segment: POST /telegram/webhook/<this> (min 8 characters)
TELEGRAM_WEBHOOK_SECRET_PATH=dev-webhook-secret-change-me

# --- OpenAI-compatible API (OpenRouter: same base URL + key for chat + embeddings) ---
# OpenRouter: https://openrouter.ai/keys  — подставьте ключ в OPENAI_API_KEY
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# Опционально для openrouter.ai (рекомендация провайдера)
# OPENROUTER_HTTP_REFERER=https://github.com/your/repo
# OPENROUTER_APP_TITLE=Analytics Bot
#
# Чат (slug-ы OpenRouter, не путать с embeddings):
PRIMARY_REASONING_MODEL=openai/gpt-4o-mini
LONG_CONTEXT_MODEL=openai/gpt-4o-mini
#
# Embeddings: в БД колонка vector(1536) — dimensions должны быть 1536.
# На OpenRouter задокументирована Google Gemini Embedding 001 (multimodal, до 3072; берём 1536).
# «Gemini Embedding 2 Preview» в каталоге OpenRouter может отличаться; при появлении slug замените EMBEDDING_MODEL.
EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# Через запятую, по очереди после основной модели (пусто = в коде fallback openai/text-embedding-3-small)
EMBEDDING_MODEL_FALLBACKS=openai/text-embedding-3-small

# --- Schedulers: football sync, scrape, embedding, analyze, retention ---
ENABLE_CRON=true
CRON_TZ=UTC

SCRAPER_TAKE_LIMIT=5
MIN_RAW_CONTENT_LENGTH=150
SCRAPER_NAVIGATION_TIMEOUT_MS=45000
FOOTBALL_SYNC_DAYS_AHEAD=14
FOOTBALL_SYNC_DAYS_PAST=7

RETENTION_DAYS=120

TASK_TIMEOUT_MS_FOOTBALL_SYNC=120000
TASK_TIMEOUT_MS_FLASHSCORE_SCRAPE=300000
TASK_TIMEOUT_MS_EMBEDDING=300000
TASK_TIMEOUT_MS_ANALYZE=600000
TASK_TIMEOUT_MS_RETENTION=60000

RAG_TOP_K=5

# =============================================================================
# Notes
# =============================================================================
# EADDRINUSE: docker app and npm run dev both want :3000 — change PORT here (e.g. 3001)
#   or stop one process.
# Empty TELEGRAM_BOT_TOKEN: bot disabled.
# Empty FOOTBALL_DATA_API_TOKEN: football_sync fails when cron runs (set token for DB matches).
# Empty OPENAI_API_KEY: embedding/analyze cron tasks will error; Football-Data sync still works.
# Embeddings: primary fails (429/502/размер вектора) — автоматически пробуются EMBEDDING_MODEL_FALLBACKS.
